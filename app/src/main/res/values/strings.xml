    <string name="hint_device">例如 867500000000000</string>
    <string name="capture">获取 ejia 当前真实定位</string>
    <string name="save">保存</string>
    <string name="device_source_real">当前为本机值（来源：%1$s）；目标 App 因签名不同，实际读到的可能不同</string>
    <string name="device_source_custom">当前为自定义值，覆盖已启用</string>
