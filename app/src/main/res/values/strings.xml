    <string name="enable_location">启用定位伪造</string>
    <string name="enable_system_location">同时伪造系统定位（兜底，防止其它 SDK 拿到真实坐标）</string>
    <string name="enable_device">启用设备标识覆盖</string>
    <string name="lat">纬度（GCJ-02）</string>
    <string name="lng">经度（GCJ-02）</string>
    <string name="radius">漂移半径（米，0 表示固定不动）</string>
    <string name="city">市</string>
    <string name="detail">详细地址（可选，拼在街道后面；省市区街道留空则用真实值）</string>
